{
  "manifest_version": 3,
  "name": "本地划词翻译",
  "version": "1.0.3",
  "description": "使用 Chrome 内置 Translator API 将选中的文字翻译为简体中文。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage-bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["selection-translator.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
