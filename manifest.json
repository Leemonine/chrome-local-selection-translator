{
  "manifest_version": 3,
  "name": "本地划词翻译",
  "version": "1.0.4",
  "description": "使用 Chrome 或 Edge 内置 Translator API 在本地翻译选中的文字。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "翻译历史与设置",
    "default_popup": "history.html"
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage-bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["selection-translator.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
